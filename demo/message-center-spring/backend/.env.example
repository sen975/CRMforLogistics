# 复制为 .env 后填写本机开发值；.env 已被 Git 忽略。
# 已进入 Git 历史的旧凭据必须先在对应供应商后台轮换。

SPRING_DATASOURCE_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
CREDENTIAL_MASTER_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
CHATAPP_WEBHOOK_SECRET=CHANGE_ME

CAMS_CUST_SPACE_ID=CHANGE_ME
CHATAPP_FROM=CHANGE_ME
ALIYUN_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME

SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=CHANGE_ME
MAIL_FROM_NAME=CHANGE_ME
IMAP_USER=CHANGE_ME
IMAP_PASSWORD=CHANGE_ME

WECOM_SUITE_ID=CHANGE_ME
WECOM_SUITE_SECRET=CHANGE_ME
WECOM_TOKEN=CHANGE_ME
WECOM_ENCODING_AES_KEY=CHANGE_ME
WECOM_LOGIN_AUTH_CORP_ID=CHANGE_ME
WECOM_CHATDATA_PROGRAM_ID=CHANGE_ME
WECOM_CHATDATA_PRIVATE_KEY_FILE=CHANGE_ME
# 代开发安装凭据通过 wecom-import-install 一次性导入，不要放入环境变量。
WECOM_AUDIT_RETENTION_DAYS=7
WECOM_AUDIT_CLEANUP_INTERVAL_SECONDS=3600
WECOM_AUDIT_CLEANUP_BATCH_SIZE=500
WECOM_AUDIT_CLEANUP_MAX_BATCHES=32

# AI：ai-topic（话题归类）与 AI 悬浮助手共用同一组凭据，但**开关各自独立**。
AI_BASE_URL=CHANGE_ME
AI_API_KEY=CHANGE_ME
AI_MODEL=deepseek-chat
# 悬浮助手开关。不开时 /api/assistant/** 恒返回 503 ASSISTANT_DISABLED（前端显示
# 「AI 助手未开启，请联系管理员配置」），而 ai-topic 照常工作 —— 所以「AI 配好了」
# 不等于「助手能用」，本项必须显式打开。
ASSISTANT_ENABLED=true
