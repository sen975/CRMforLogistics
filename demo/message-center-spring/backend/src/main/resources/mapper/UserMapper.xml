<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crmforlogistics.messagecenter.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.crmforlogistics.messagecenter.entity.UserEntity">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="username_normalized" property="usernameNormalized"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="display_name" property="displayName"/>
        <result column="status" property="status"/>
        <result column="last_login_at" property="lastLoginAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
    </resultMap>

    <select id="findByUsername" resultMap="userResultMap">
        select id, username, username_normalized, password_hash, display_name,
               status, last_login_at, created_at, updated_at, deleted_at
        from users
        where username = #{username}
          and deleted_at is null
        limit 1
    </select>

    <select id="findByUsernameNormalized" resultMap="userResultMap">
        select id, username, username_normalized, password_hash, display_name,
               status, last_login_at, created_at, updated_at, deleted_at
        from users
        where username_normalized = #{normalized}
          and deleted_at is null
        limit 1
    </select>

</mapper>
