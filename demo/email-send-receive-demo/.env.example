# SMTP send config
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=your-account@example.com
SMTP_PASSWORD=your-password-or-app-password
MAIL_FROM=your-account@example.com
MAIL_FROM_NAME=CRM Logistics Mail Demo

# MAIL_TO is only the default recipient for the send command.
# receive/watch read all messages from IMAP_USERNAME + INBOX_FOLDER.
# You can override send recipient with: .\mail-demo.ps1 send -To xxx@example.com
MAIL_TO=receiver@example.com

# IMAP receive config
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=your-account@example.com
IMAP_PASSWORD=your-password-or-app-password
INBOX_FOLDER=INBOX
# Sent folder name depends on your mailbox provider. Common values: Sent, Sent Messages, Sent Items, 已发送, 已发送邮件.
# Set it to empty if you do not want to import sent mails.
SENT_FOLDER=Sent

# receive/watch behavior
RECEIVE_LIMIT=10
WATCH_POLL_SECONDS=30
DATA_DIR=data
WEB_PORT=8088
