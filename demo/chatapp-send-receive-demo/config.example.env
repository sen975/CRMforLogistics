ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret

# 阿里云 ChatApp/CAMS 区域。ChatApp 常用 ap-southeast-1。
CAMS_REGION=ap-southeast-1
CAMS_ENDPOINT=cams.ap-southeast-1.aliyuncs.com

# ChatApp 客户空间 ID，通常是 cams- 开头。
CUST_SPACE_ID=

# 你的 WhatsApp/ChatApp 发送号码，不带 + 号，例如 8613428277520。
CHATAPP_FROM=

# 测试收件人号码。
CHATAPP_TO=

# 页面和 webhook 监听端口。
SERVER_PORT=8077

# 页面上传图片/视频/文件的大小上限，默认 20MB。
MEDIA_MAX_BYTES=20971520

# 发送模式：text 或 template。
CHATAPP_SEND_MODE=text
CHATAPP_MESSAGE=hello from ChatApp Java demo
# 普通文本模式会自动把 CHATAPP_MESSAGE 包成 {"text":"..."}。
# 如果要发文档/图片/链接等高级内容，可以手动覆盖 Content JSON。
CHATAPP_CONTENT_JSON=

# 如果发模板消息，填写下面这些。
CHATAPP_TEMPLATE_CODE=
CHATAPP_TEMPLATE_NAME=
CHATAPP_LANGUAGE=en_US
CHATAPP_TEMPLATE_PARAMS_JSON={}

# SDK 里的必填/可选字段。普通 WhatsApp 文本一般这样填：
CHATAPP_CHANNEL_TYPE=whatsapp
CHATAPP_TYPE=message
CHATAPP_MESSAGE_TYPE=text

# 模板库同步配置：sync-templates 命令调用 ListChatappTemplate / GetChatappTemplateDetail。
TEMPLATE_FILE=data/templates.json
TEMPLATE_PAGE_SIZE=50
TEMPLATE_MAX_PAGES=10
# 可选：按语言、名称、编码、审核状态、分类或模板类型过滤；留空表示不过滤。
TEMPLATE_LANGUAGE=
TEMPLATE_NAME=
TEMPLATE_CODE=
TEMPLATE_AUDIT_STATUS=
TEMPLATE_CATEGORY=
TEMPLATE_TYPE=
# sync 拉历史消息前默认会先刷新模板库，确保模板消息能显示完整正文。
SYNC_TEMPLATES_BEFORE_MESSAGES=true

# 历史补拉配置：sync 命令调用 ListChatappMessage。
SYNC_PAGE_SIZE=50
SYNC_MAX_PAGES=10
# 默认补拉最近 7 天；如果填了下面的起止时间，则优先用起止时间。
SYNC_LOOKBACK_DAYS=7
# 可选：只补拉某个客户号码。
SYNC_USER_NUMBER=
# 可选：毫秒时间戳，优先级高于 *_STR。
SYNC_START_TIME=
SYNC_END_TIME=
# 可选：本地时间字符串，例如 2026-07-10 00:00:00。
SYNC_START_TIME_STR=
SYNC_END_TIME_STR=
# 可选：按消息状态/客户端接收状态过滤，不确定枚举时先留空。
SYNC_MESSAGE_STATUS=
SYNC_CLIENT_ACCEPT_STATUS=
