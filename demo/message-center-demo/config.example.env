# 标记说明：
# [企业微信生产必填] 表示真实扫码登录、代开发授权或专区同步必须配置。
# [按功能必填] 表示只有启用对应邮件、ChatApp、摘要或转写功能时才必须配置。
# 未标记的配置均有默认值，或属于可选的容量、超时和文件路径调整项。

# Web 服务
WEB_PORT=8099
# 仅限本地开发时设为 true；开启后拒绝绑定非回环地址。
LOCAL_DEV_MODE=false
WEB_BIND_ADDRESS=0.0.0.0
DATA_DIR=data
CONTACT_GROUP_FILE=data/contact-groups.jsonl
MEDIA_MAX_BYTES=20971520
MEDIA_CACHE_DIR=data/media-cache
MEDIA_PROXY_TIMEOUT_SECONDS=15
CHATAPP_MEDIA_PRESIGNED_TIMEOUT_SECONDS=5

# PostgreSQL 数据库
# [按功能必填：每日摘要] 启用 WECOM_DAILY_SUMMARY_ENABLED 后必须提供可用数据库和密码文件。
DATABASE_URL=jdbc:postgresql://localhost:5432/message_center
DATABASE_USER=message_center
DATABASE_PASSWORD_FILE=secrets/postgres_password
POSTGRES_DB=message_center
POSTGRES_USER=message_center
POSTGRES_PORT=5432

# MinIO 对象存储
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY_FILE=secrets/minio_access_key
MINIO_SECRET_KEY_FILE=secrets/minio_secret_key
MINIO_BUCKET=message-center
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 应用加密与有界后台任务
# [企业微信生产必填] 文件内容必须是 Base64 编码，解码后恰好 32 字节。
CREDENTIAL_MASTER_KEY_FILE=secrets/credential_master_key
WORKER_BATCH_SIZE=25
WORKER_MAX_ATTEMPTS=6

# 现有邮件 demo 数据源
EMAIL_DATA_DIR=../email-send-receive-demo/data
EMAIL_CONTACT_GROUP_FILE=../email-send-receive-demo/data/contact-groups.jsonl
# 邮件附件：限制单封邮件的附件数量、总大小以及本地附件存储总量。
# 二进制附件存放在 EMAIL_DATA_DIR/attachments；临时上传文件存放在
# EMAIL_DATA_DIR/attachment-tmp。EMAIL_DATA_DIR/attachment-recovery 保存有界的
# prepared/accepted 恢复记录，并在应用启动时执行对账。
# SMTP 发送失败时删除临时文件；孤儿清理只删除已过期且未被引用的附件目录，
# 绝不删除仍被历史消息引用的附件。
EMAIL_ATTACHMENT_MAX_COUNT=16
EMAIL_ATTACHMENT_MAX_TOTAL_BYTES=20971520
EMAIL_ATTACHMENT_STORAGE_MAX_BYTES=10737418240

# 现有 ChatApp demo 数据源
CHATAPP_DATA_FILE=../chatapp-send-receive-demo/data/messages.jsonl
CHATAPP_TEMPLATE_FILE=../chatapp-send-receive-demo/data/templates.json

# SMTP 邮件发送
# [按功能必填：发送邮件] SMTP_HOST、SMTP_USERNAME、SMTP_PASSWORD、MAIL_FROM。
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=CRM Logistics Message Center

# IMAP 邮件接收
# [按功能必填：接收邮件] IMAP_HOST、IMAP_USERNAME、IMAP_PASSWORD。
MAIL_PROVIDER=auto
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=
INBOX_FOLDER=INBOX
SENT_FOLDER=Sent
RECEIVE_LIMIT=10

# 中国移动 139 邮箱 IMAP 直连模式。Java 17 接收 139 邮件时，
# 使用此模式替代旧的 stunnel 桥接方案。
# MAIL_PROVIDER=139
# IMAP_HOST=imap.139.com
# IMAP_PORT=993
# IMAP_SSL=true

# 阿里云 ChatApp / CAMS
# [按功能必填：ChatApp] ALIYUN_ACCESS_KEY_ID、ALIYUN_ACCESS_KEY_SECRET、CUST_SPACE_ID、CHATAPP_FROM。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
CAMS_REGION=ap-southeast-1
CAMS_ENDPOINT=cams.ap-southeast-1.aliyuncs.com
CUST_SPACE_ID=
CHATAPP_FROM=
CHATAPP_LANGUAGE=zh_CN
CHATAPP_CHANNEL_TYPE=whatsapp
CHATAPP_TYPE=message
CHATAPP_MESSAGE_TYPE=text
CHATAPP_TEMPLATE_TYPE=template
# Web 监听成功后异步拉取消息；每轮完成 5 秒后开始下一轮
CHATAPP_MESSAGE_AUTO_SYNC_ENABLED=true
CHATAPP_TEMPLATE_AUTO_SYNC_ENABLED=true
CHATAPP_TEMPLATE_SYNC_INTERVAL_SECONDS=300
SYNC_PAGE_SIZE=20
SYNC_MAX_PAGES=2
SYNC_LOOKBACK_DAYS=1
SYNC_INCREMENTAL=true
SYNC_OVERLAP_MINUTES=30
SYNC_USER_NUMBER=
SYNC_MESSAGE_STATUS=
SYNC_CLIENT_ACCEPT_STATUS=
SYNC_TEMPLATES_BEFORE_MESSAGES=false
CHATAPP_MEDIA_USE_CAMS_PRESIGNED=true
CHATAPP_MEDIA_PRECACHE_MODE=background
CHATAPP_MEDIA_PRECACHE_SKIPPED=false
CHATAPP_MEDIA_PRECACHE_THREADS=1
CHATAPP_MEDIA_PRECACHE_QUEUE_SIZE=100
CHATAPP_MEDIA_BUCKET=
CHATAPP_MEDIA_ENDPOINT=
CHATAPP_MEDIA_SIGNED_URL_TTL_SECONDS=900
TEMPLATE_PAGE_SIZE=50
TEMPLATE_MAX_PAGES=40
TEMPLATE_LANGUAGE=zh_CN
TEMPLATE_NAME=
TEMPLATE_CODE=
TEMPLATE_AUDIT_STATUS=
TEMPLATE_CATEGORY=
TEMPLATE_TYPE=

# 企业微信代开发授权 Suite 与会话展示组件
# 本地开发替代数据源；启用后不会调用企业微信线上接口。
LOCAL_WECOM_DATA_SOURCE=fixture
LOCAL_WECOM_DATA_FILE=data/local-wecom-source.jsonl
LOCAL_WECOM_TARGET_FILE=data/local-wecom-messages.jsonl
# [企业微信生产必填：代开发授权] SuiteID 与 SuiteSecret。
WECOM_SUITE_ID=
WECOM_SUITE_SECRET=
# [企业微信生产必填：回调验签解密] 企业微信后台配置的 Token 与 EncodingAESKey。
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# 回调明文中的 receiveId；与 WECOM_SUITE_ID 相同时留空。
WECOM_CALLBACK_RECEIVE_ID=
# 回调取得的 permanent_code 是代开发应用 Secret，并加密保存在此 JSONL 文件中。
# 不要再把它重复配置为 WECOM_SECRET。
WECOM_AUTHORIZATION_INSTALLATIONS_FILE=data/wecom-authorization-installations.jsonl
WECOM_AUTHORIZATION_AUDIT_FILE=data/wecom-authorization-audit.jsonl
# 企业微信本地审计：当前文件最大 1 MiB，历史 gzip 保留最近 7 个 UTC 自然日。
# 两条审计流共享以下治理参数；授权写入 required，viewer 写入 best-effort。
AUDIT_RETENTION_DAYS=7
AUDIT_FILE_MAX_BYTES=1048576
# 单条审计流的当前、归档、恢复和未知文件总预算 8 MiB。
AUDIT_STREAM_MAX_BYTES=8388608
# 可用磁盘低于 64 MiB 时阻断授权审计写入，viewer 只降级并限频告警。
AUDIT_MIN_FREE_DISK_BYTES=67108864
AUDIT_WARNING_INTERVAL_SECONDS=3600
# 必须精确指定一个已经安装该代开发应用的企业。
# [企业微信生产必填] 值必须匹配授权安装文件中的 active authCorpId。
WECOM_LOGIN_AUTH_CORP_ID=
# 浏览器 Web 登录组件使用的服务商登录授权 Suite。
# 两项都必须配置；这里不是企业 CorpID，也不是应用 AgentID。
# [企业微信生产必填：扫码登录]
WECOM_LOGIN_SUITE_ID=
WECOM_LOGIN_SUITE_SECRET=
WECOM_AUTHORIZATION_QUEUE_CAPACITY=64
# [企业微信生产必填：扫码登录与官方组件] 必须改为实际公网 HTTPS 源。
WECOM_ALLOWED_JSAPI_ORIGINS=http://localhost:8099
# 真实扫码登录时，两项地址必须使用企业微信后台配置的同一个公网 HTTPS 源。
# [企业微信生产必填：扫码登录] 必须是企业微信后台登记的回调地址。
WECOM_LOGIN_REDIRECT_URI=http://localhost:8099/
WECOM_LOGIN_ATTEMPT_TTL_SECONDS=300
WECOM_LOGIN_MAX_PENDING=256
WECOM_DATA_FILE=wecom-messages.jsonl
# 绑定到该代开发应用安装记录的数据智能专区程序与能力。
# [企业微信生产必填：专区自动同步] 企业微信后台关联后的程序 ID。
WECOM_CHATDATA_PROGRAM_ID=
WECOM_CHATDATA_ABILITY_ID=conversation_viewer_sync
# Web 监听成功后立即执行首轮；每轮结束后等待 60 秒再执行下一轮。
WECOM_CHATDATA_AUTO_SYNC_ENABLED=true
WECOM_CHATDATA_AUTO_SYNC_INTERVAL_SECONDS=60
# 临时输出服务端上游 errmsg 诊断；正常运行时保持关闭。
WECOM_CHATDATA_DIAGNOSTICS=false
# 与 chatdata/set_public_key 公钥匹配的 PKCS#8 RSA-2048 私钥绝对路径。
# [企业微信生产必填：专区自动同步] 必须是服务器上的绝对路径且文件可读。
WECOM_CHATDATA_PRIVATE_KEY_FILE=/absolute/path/to/wecom_chatdata_private_key.pem
# [企业微信生产必填：专区自动同步] 必须与企业微信后台登记的公钥版本一致。
WECOM_CHATDATA_PUBLIC_KEY_VERSION=1
# 收到真实 suite_ticket 后异步注册由私钥推导出的公钥。
WECOM_CHATDATA_PUBLIC_KEY_AUTO_REGISTER=false
WECOM_CHATDATA_PUBLIC_KEY_REGISTRATION_FILE=wecom-chatdata-public-key-registration.json
WECOM_CHATDATA_CURSOR_FILE=wecom-chatdata-cursor.json
WECOM_CHATDATA_SYNC_LIMIT=200
WECOM_CHATDATA_SYNC_MAX_PAGES=5
WECOM_CHATDATA_SYNC_TIMEOUT_SECONDS=15
WECOM_CHATDATA_STORE_MAX_MESSAGES=5000
WECOM_CHATDATA_STORE_MAX_BYTES=8388608
# 官方每日摘要复用同一个程序 ID，并调用该程序绑定的第二个固定能力。
# [按功能必填：每日摘要] 开启后还必须配置上方 PostgreSQL 和该摘要能力 ID。
WECOM_DAILY_SUMMARY_ENABLED=false
WECOM_DAILY_SUMMARY_ABILITY_ID=conversation_daily_summary
WECOM_DAILY_SUMMARY_HOUR=0
WECOM_DAILY_SUMMARY_MINUTE=5
WECOM_DAILY_SUMMARY_MAX_BATCHES=32
WECOM_DAILY_SUMMARY_MAX_TRANSIENT_ATTEMPTS=20
WECOM_DAILY_SUMMARY_POLL_INITIAL_SECONDS=30
WECOM_DAILY_SUMMARY_MAX_BACKOFF_SECONDS=900
WECOM_DAILY_SUMMARY_MAX_WAIT_HOURS=24
# 浏览器 viewer 登录身份有效期；token 只保存在内存中。
WECOM_VIEWER_AUTH_TTL_SECONDS=28800
# 单次官方消息展示 session 按设计保持短时有效。
WECOM_VIEWER_SESSION_TTL_SECONDS=300
WECOM_VIEWER_MAX_MESSAGES=15
WECOM_VIEWER_SESSION_RATE_LIMIT=10
WECOM_VIEWER_AUDIT_FILE=data/wecom-viewer-audit.jsonl
WECOM_TOKEN_REFRESH_SKEW_SECONDS=300

# 本地 MP3 通话录音转写 runtime；FunASR 是内部私有的伴随服务。
# [按功能必填：录音转写] FUNASR_BASE_URL 必须指向可访问的 FunASR 服务；模型名需与服务一致。
CALL_RECORD_DATA_DIR=data/call-records
CALL_RECORD_MAX_AUDIO_BYTES=104857600
CALL_RECORD_MAX_DURATION_SECONDS=7200
CALL_RECORD_STORAGE_MAX_BYTES=10737418240
CALL_RECORD_MAX_RECORDS=10000
CALL_RECORD_QUEUE_CAPACITY=64
CALL_RECORD_WORKER_CONCURRENCY=1
CALL_RECORD_LEASE_SECONDS=2100
CALL_RECORD_MAX_ATTEMPTS=3
CALL_RECORD_MAX_RESPONSE_BYTES=10485760
CALL_RECORD_MAX_SEGMENTS=20000
CALL_RECORD_MAX_REVISIONS=20
CALL_AUDIO_SESSION_TTL_SECONDS=300
CALL_AUDIO_SESSION_MAX_PER_ACTOR=8
CALL_AUDIO_SESSION_MAX_ACTIVE=256
FUNASR_BASE_URL=http://funasr:8000
FUNASR_MODEL=sensevoice
FUNASR_CONNECT_TIMEOUT_SECONDS=3
FUNASR_REQUEST_TIMEOUT_SECONDS=1800
