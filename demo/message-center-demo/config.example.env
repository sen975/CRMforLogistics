# Web
WEB_PORT=8099
DATA_DIR=data
CONTACT_GROUP_FILE=data/contact-groups.jsonl
MEDIA_MAX_BYTES=20971520
MEDIA_CACHE_DIR=data/media-cache
MEDIA_PROXY_TIMEOUT_SECONDS=15
CHATAPP_MEDIA_PRESIGNED_TIMEOUT_SECONDS=5

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/message_center
DATABASE_USER=message_center
DATABASE_PASSWORD_FILE=secrets/postgres_password
POSTGRES_DB=message_center
POSTGRES_USER=message_center
POSTGRES_PORT=5432

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY_FILE=secrets/minio_access_key
MINIO_SECRET_KEY_FILE=secrets/minio_secret_key
MINIO_BUCKET=message-center
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application encryption and bounded workers
CREDENTIAL_MASTER_KEY_FILE=secrets/credential_master_key
WORKER_BATCH_SIZE=25
WORKER_MAX_ATTEMPTS=6

# Existing email demo data source
EMAIL_DATA_DIR=../email-send-receive-demo/data
EMAIL_CONTACT_GROUP_FILE=../email-send-receive-demo/data/contact-groups.jsonl

# Existing ChatApp demo data source
CHATAPP_DATA_FILE=../chatapp-send-receive-demo/data/messages.jsonl
CHATAPP_TEMPLATE_FILE=../chatapp-send-receive-demo/data/templates.json

# SMTP email sending
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=CRM Logistics Message Center

# IMAP email receiving
MAIL_PROVIDER=auto
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=
INBOX_FOLDER=INBOX
SENT_FOLDER=Sent
RECEIVE_LIMIT=10

# China Mobile 139 IMAP direct mode. Use this instead of the old stunnel
# bridge when receiving 139 email with Java 17.
# MAIL_PROVIDER=139
# IMAP_HOST=imap.139.com
# IMAP_PORT=993
# IMAP_SSL=true

# Alibaba Cloud ChatApp / CAMS
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
CAMS_REGION=ap-southeast-1
CAMS_ENDPOINT=cams.ap-southeast-1.aliyuncs.com
CUST_SPACE_ID=
CHATAPP_FROM=
CHATAPP_LANGUAGE=zh_CN
CHATAPP_CHANNEL_TYPE=whatsapp
CHATAPP_TYPE=message
CHATAPP_MESSAGE_TYPE=text
CHATAPP_TEMPLATE_TYPE=template
SYNC_PAGE_SIZE=20
SYNC_MAX_PAGES=2
SYNC_LOOKBACK_DAYS=1
SYNC_INCREMENTAL=true
SYNC_OVERLAP_MINUTES=30
SYNC_USER_NUMBER=
SYNC_MESSAGE_STATUS=
SYNC_CLIENT_ACCEPT_STATUS=
SYNC_TEMPLATES_BEFORE_MESSAGES=false
CHATAPP_MEDIA_USE_CAMS_PRESIGNED=true
CHATAPP_MEDIA_PRECACHE_MODE=background
CHATAPP_MEDIA_PRECACHE_SKIPPED=false
CHATAPP_MEDIA_PRECACHE_THREADS=1
CHATAPP_MEDIA_PRECACHE_QUEUE_SIZE=100
CHATAPP_MEDIA_BUCKET=
CHATAPP_MEDIA_ENDPOINT=
CHATAPP_MEDIA_SIGNED_URL_TTL_SECONDS=900
TEMPLATE_PAGE_SIZE=50
TEMPLATE_MAX_PAGES=10
TEMPLATE_LANGUAGE=zh_CN
TEMPLATE_NAME=
TEMPLATE_CODE=
TEMPLATE_AUDIT_STATUS=
TEMPLATE_CATEGORY=
TEMPLATE_TYPE=

# WeCom delegated-authorization suite and conversation viewer
WECOM_SUITE_ID=
WECOM_SUITE_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# Callback plaintext receiveId. Leave empty when it is identical to WECOM_SUITE_ID.
WECOM_CALLBACK_RECEIVE_ID=
WECOM_AUTHORIZATION_INSTALLATIONS_FILE=data/wecom-authorization-installations.jsonl
# This must identify exactly one enterprise that has installed the delegated app.
WECOM_LOGIN_AUTH_CORP_ID=
WECOM_AUTHORIZATION_QUEUE_CAPACITY=64
WECOM_ALLOWED_JSAPI_ORIGINS=http://localhost:8099
# Real QR login must use the same public HTTPS origin configured in WeCom for both values.
WECOM_LOGIN_REDIRECT_URI=http://localhost:8099/
WECOM_LOGIN_ATTEMPT_TTL_SECONDS=300
WECOM_LOGIN_MAX_PENDING=256
WECOM_DATA_FILE=wecom-messages.jsonl
# Data & Smart Zone program/ability bound to this delegated app installation.
WECOM_CHATDATA_PROGRAM_ID=
WECOM_CHATDATA_ABILITY_ID=conversation_viewer_sync
# Absolute PKCS#8 RSA-2048 private key path matching chatdata/set_public_key.
WECOM_CHATDATA_PRIVATE_KEY_FILE=/absolute/path/to/wecom_chatdata_private_key.pem
WECOM_CHATDATA_PUBLIC_KEY_VERSION=1
WECOM_CHATDATA_CURSOR_FILE=wecom-chatdata-cursor.json
WECOM_CHATDATA_SYNC_LIMIT=200
WECOM_CHATDATA_SYNC_MAX_PAGES=5
WECOM_CHATDATA_SYNC_TIMEOUT_SECONDS=15
WECOM_CHATDATA_STORE_MAX_MESSAGES=5000
WECOM_CHATDATA_STORE_MAX_BYTES=8388608
# Official daily summary uses the same program ID with its second fixed ability.
WECOM_DAILY_SUMMARY_ENABLED=false
WECOM_DAILY_SUMMARY_ABILITY_ID=conversation_daily_summary
WECOM_DAILY_SUMMARY_HOUR=0
WECOM_DAILY_SUMMARY_MINUTE=5
WECOM_DAILY_SUMMARY_MAX_BATCHES=32
WECOM_DAILY_SUMMARY_MAX_TRANSIENT_ATTEMPTS=20
WECOM_DAILY_SUMMARY_POLL_INITIAL_SECONDS=30
WECOM_DAILY_SUMMARY_MAX_BACKOFF_SECONDS=900
WECOM_DAILY_SUMMARY_MAX_WAIT_HOURS=24
WECOM_VIEWER_SESSION_TTL_SECONDS=300
WECOM_VIEWER_MAX_MESSAGES=10
WECOM_VIEWER_SESSION_RATE_LIMIT=10
WECOM_VIEWER_AUDIT_FILE=data/wecom-viewer-audit.jsonl
WECOM_VIEWER_AUDIT_MAX_BYTES=1048576
WECOM_TOKEN_REFRESH_SKEW_SECONDS=300
