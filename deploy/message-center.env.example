# 复制到 /etc/message-center/message-center.env，填入真实值后设置权限 600。
# 本文件只放变量名和非敏感默认值，禁止提交生产密钥。

SPRING_PROFILES_ACTIVE=chatapp-only
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8107
SERVER_FORWARD_HEADERS_STRATEGY=framework
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/message_center
SPRING_DATASOURCE_USERNAME=message_center
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=message-center
FUNASR_BASE_URL=http://127.0.0.1:8000

CREDENTIAL_MASTER_KEY=CHANGE_ME_32_BYTE_BASE64_MASTER_KEY
CHATAPP_WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET

APP_DATA_DIR=/var/lib/message-center
APP_LOCAL_DEV_MODE=false
APP_WEB_BIND_ADDRESS=127.0.0.1
APP_CUST_SPACE_ID=CHANGE_ME_CAMS_CUST_SPACE_ID
APP_CHATAPP_FROM=CHANGE_ME_CHATAPP_SENDER
APP_CHATAPP_SYNC_ENABLED=true
APP_CHATAPP_TEMPLATE_RECONCILE_ENABLED=true
APP_ALIYUN_ACCESS_KEY_ID=CHANGE_ME_ALIYUN_ACCESS_KEY_ID
APP_ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME_ALIYUN_ACCESS_KEY_SECRET
APP_CAMS_REGION=ap-southeast-1
APP_CAMS_ENDPOINT=cams.ap-southeast-1.aliyuncs.com
APP_EMAIL_SYNC_ENABLED=false

APP_WECOM_ENABLED=false
APP_WECOM_CREDENTIAL_MIGRATION_ENABLED=false
APP_WECOM_SYNC_ENABLED=false
APP_WECOM_CHATDATA_AUTO_SYNC_ENABLED=false
APP_WECOM_CHATDATA_PUBLIC_KEY_AUTO_REGISTER=false
APP_WECOM_DAILY_SUMMARY_ENABLED=false
